# ————————————————————————————————————————————————————————————
# MOONBUILDS — environment variables
# Copy this file to `.env.local` for local development, and set the
# same variables in your hosting provider's dashboard for production.
# NEVER commit a real .env file — .gitignore already excludes it.
# ————————————————————————————————————————————————————————————

# REQUIRED for email delivery (without these the form falls back to
# an honest WhatsApp handoff instead of pretending to send):
# Create a free API key at https://resend.com
RESEND_API_KEY=
# Where enquiries are delivered, e.g. Moonbuilds001.com@gmail.com
CONTACT_TO_EMAIL=
# Verified Resend sender identity, e.g. "MOONBUILDS <enquiries@yourdomain.com>"
# Optional — defaults to Resend's onboarding sender while testing.
CONTACT_FROM_EMAIL=

# Canonical public URL of the site (used in sitemap, robots, OG tags).
# Current: https://moonbuilds-website.moonbuilds001-com.workers.dev
NEXT_PUBLIC_SITE_URL=

# OPTIONAL — analytics. Only loads after the visitor allows it in the
# consent banner. Leave empty to disable analytics entirely.
NEXT_PUBLIC_GA_ID=

# OPTIONAL — Cloudflare Turnstile spam protection.
# Create a Turnstile widget at https://dash.cloudflare.com (free).
# If left empty, honeypot + rate limiting still protect the form.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
